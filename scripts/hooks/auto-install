#!/bin/sh
# Shared body for the git hooks that keep the installed marc.app current.
# Set MARC_SKIP_AUTO_INSTALL=1 to skip, MARC_INSTALL_DIR to install elsewhere.
set -eu

if [ "${MARC_SKIP_AUTO_INSTALL:-0}" = "1" ]; then
    exit 0
fi

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
STAMP="$ROOT/.build/installed-commit"

HEAD_SHA=$(git -C "$ROOT" rev-parse HEAD 2>/dev/null) || exit 0
DIRTY=$(git -C "$ROOT" status --porcelain -- Sources scripts AppBundle Package.swift)

if [ -z "$DIRTY" ] && [ -f "$STAMP" ] && [ "$(cat "$STAMP")" = "$HEAD_SHA" ]; then
    exit 0
fi

printf 'marc: rebuilding and installing (%s)…\n' "$1"
if "$ROOT/scripts/install-app.sh"; then
    mkdir -p "$ROOT/.build"
    printf '%s\n' "$HEAD_SHA" > "$STAMP"
else
    printf 'marc: install failed; run ./scripts/install-app.sh by hand.\n' >&2
fi
